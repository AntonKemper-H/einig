# Copy this file to .env and fill in the values. Never commit .env.
# Real values are shared privately inside the team.

# Flask session signing key (any long random string)
SECRET_KEY=

# Google Places API (New) – server only
GOOGLE_MAPS_API_KEY=

# Google Maps Embed API – browser, restricted to our domain
GOOGLE_MAPS_EMBED_KEY=

# Hosted Postgres for the deployed app. Leave empty locally to use SQLite.
DATABASE_URL=
